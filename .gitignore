# ── Secrets & local config ──────────────────────────────────────────────
.env
.env.*
*.pem

# ── Database & WAL sidecars (local runtime state — never committed) ──────
# (The live DB lives in ~/Library/Application Support/Thresher/, outside
#  the repo, but these globs guard against any local copy landing in-tree.)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Third-party / PII data — NEVER commit (the author's real contacts & mail) ───
# Real seed is local-only; a placeholder seed.example.sql IS committed (see §3).
backend/db/seed.sql
*.eml
# The *.eml glob above is the guard that keeps real third-party mail out of the
# repo, and it STAYS broad on purpose: the default for a mail file must be
# "not committed".
#
# ONE narrow exception, added 2026-09-12: the SYNTHETIC fixture corpus. Every
# file under it is generated by scripts/generate_corpus.py from invented
# personas on RFC 2606 reserved domains (example.com/.org/.net) — there is no
# real address or real message in it, and tests assert exactly that
# (backend/tests/test_corpus.py). The exception is scoped to that one directory
# so a stray .eml anywhere else is still ignored by default.
!backend/tests/corpus/
!backend/tests/corpus/*.eml
#
# NOT excepted, and deliberately so: generated demo/dev corpora and any
# database built from them. The generator writes those to /corpus at the repo
# root — regenerate them, never commit them.
#
# Anchored with a LEADING SLASH on purpose. An unanchored `corpus/` matches a
# directory of that name at ANY depth, so it swallowed backend/tests/corpus/
# and re-ignored the fixtures two lines after they were excepted — and because
# git does not descend into an ignored directory, the `!` rules above could not
# rescue the files inside it.
/corpus/
# fixtures/eml/

# files.zip bundles a copy of the REAL seed.sql (the author's contacts) — the
# backend/db/seed.sql rule above does NOT reach inside an archive, so ignore
# zips explicitly to keep that PII out of history.
*.zip

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# ── Backend runtime state from scripts/backend.sh (pids + logs) ─────────
backend/.run/

# ── macOS ───────────────────────────────────────────────────────────────
.DS_Store

# ── Editors / IDEs ────────────────────────────────────────────────────────
# JetBrains project files carry machine-local paths/state (workspace.xml etc.).
.idea/
# Claude Code per-machine local settings (the shared settings.json, if any, is fine).
.claude/settings.local.json

# ── Xcode (for the frontend/ phase, lands later) ────────────────────────
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/

# external docs
docs/playbook/
project.xcworkspace/


# Session artifact, not a project artifact: regenerated as needed, and leaving it
# untracked made the build's provenance stamp report `-dirty` permanently. A
# dirty flag that is always on is indistinguishable from no flag at all, which
# defeats the point of having one (A2).
docs/punch-list.md

# D68: vendored third-party deps for the bundled backend. Generated at build
# time into the app bundle, never committed — they are resolved per-interpreter
# by scripts/bundle-backend.sh, so a committed copy would be a stale snapshot
# built for whoever ran it last.
backend/_vendor/
_vendor/
